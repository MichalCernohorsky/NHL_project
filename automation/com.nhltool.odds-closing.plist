<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Closing watcher: starts 17:00 CZ = 11:00 ET, before the earliest weekend
  matinee (12:30 ET = 18:30 CZ), then sleeps between puck drops and prices
  each game 10 minutes before it. Ends after the last West Coast game,
  typically 04:00-05:00 CZ. caffeinate keeps the Mac awake while it waits;
  it does NOT wake a Mac that is asleep or off.

  Local Mac time (CET/CEST). StartCalendarInterval is pinned to the wall
  clock; a run missed during sleep starts after wake-up. launchd never runs
  two copies of one job at once.

  __REPO_ROOT__ is replaced with the absolute repository path by
  scripts/install_automation.sh (same scheme as NBA_tool).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nhltool.odds-closing</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO_ROOT__/scripts/daily_wrapper.sh</string>
        <string>odds-closing</string>
        <string>make</string>
        <string>odds-closing</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>17</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__REPO_ROOT__/logs/launchd_odds-closing.out</string>
    <key>StandardErrorPath</key>
    <string>__REPO_ROOT__/logs/launchd_odds-closing.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>NHL_TOOL_JOB</key>
        <string>odds-closing</string>
    </dict>

    <key>ExitTimeOut</key>
    <integer>30</integer>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
